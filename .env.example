# NAS Credentials
NAS_USERNAME=a4d
NAS_PASSWORD=your_password_here
NAS_HOST=net-store.local

# Plex Configuration
PLEX_UID=1000
PLEX_GID=1000
PLEX_TZ=America/Chicago

# Tailscale VPN (for secure remote access)
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
# Make it reusable and set it to never expire for this server
TAILSCALE_AUTHKEY=tskey-auth-your-key-here
